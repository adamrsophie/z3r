#!/bin/sh
# Windows configuration (run by R with the Rtools shell).
#
# Search order:
#   1. PKG_CPPFLAGS and PKG_LIBS, used verbatim when PKG_LIBS is set.
#   2. Z3_DIR (the root of an unpacked official Z3 release, containing
#      include/ and bin/), or Z3_INCLUDE_DIR and Z3_LIB_DIR.
#   3. pkg-config z3 (for example an Rtools or MSYS2 z3 package).
#
# Official Z3 releases ship libz3.dll. The C API has a plain C ABI, so the
# MinGW toolchain of Rtools links against the DLL directly. The DLL, the
# Microsoft runtime DLLs shipped beside it and Z3's license are copied next
# to z3r.dll at install time, where Windows finds them when R loads the
# package. Headers and DLL must be the same Z3 version.#
# Nothing is downloaded by default. When no Z3 is found and Z3R_DOWNLOAD is
# "true" (or the build runs on R-universe, which sets MY_UNIVERSE, and
# Z3R_DOWNLOAD is not "false"), configure downloads one pinned official Z3
# release over https, verifies its SHA-256 checksum, and installs libz3 and
# Z3's license next to z3r's shared library.

: "${R_HOME:=`R RHOME`}"
RBIN="${R_HOME}/bin${R_ARCH_BIN}/R"
CXX=`"${RBIN}" CMD config CXX`
CXXFLAGS=`"${RBIN}" CMD config CXXFLAGS`

try_z3 () {
  # $1 = preprocessor flags, $2 = linker flags (both may quote paths with
  # spaces; eval honors the quotes), $3 = DLL to copy beside the test program.
  cat > conftest.cpp <<EOF
#include <z3.h>
#include <stdio.h>
#if defined(__has_include)
#  if __has_include(<z3_version.h>)
#    include <z3_version.h>
#  endif
#endif
int main(void) {
  unsigned major, minor, build, rev;
  Z3_get_version(&major, &minor, &build, &rev);
  printf("%u.%u.%u\n", major, minor, build);
#ifdef Z3_MAJOR_VERSION
  if (major != Z3_MAJOR_VERSION || minor != Z3_MINOR_VERSION || build != Z3_BUILD_NUMBER) {
    fprintf(stderr, "Z3 headers are version %d.%d.%d but the library is %u.%u.%u",
            Z3_MAJOR_VERSION, Z3_MINOR_VERSION, Z3_BUILD_NUMBER, major, minor, build);
    return 3;
  }
#endif
  void *p = (void *) &Z3_get_string_contents;
  if (!p) return 2;
  if (major != 4) return major > 4 ? 0 : 1;
  if (minor != 8) return minor > 8 ? 0 : 1;
  return build >= 13 ? 0 : 1;
}
EOF
  rm -f conftest.exe
  eval "${CXX} $1 ${CXXFLAGS} conftest.cpp -o conftest.exe $2" >> config.log 2>&1 || return 1
  # The test program needs the DLL and the runtime DLLs shipped beside it.
  if test -n "$3"; then
    for f in ${Z3_RUNTIME_DLLS}; do
      if test -f "$3/$f"; then cp "$3/$f" . 2>> config.log; fi
    done
  fi
  Z3_FOUND_VERSION=`./conftest.exe 2> conftest.err`
  status=$?
  cat conftest.err >> config.log
  if test ${status} -ne 0; then
    if test ${status} -eq 3; then
      echo "configure.win: `cat conftest.err`; ignoring this Z3" >&2
    elif test -n "${Z3_FOUND_VERSION}"; then
      echo "configure.win: found Z3 ${Z3_FOUND_VERSION}, but z3r needs 4.8.13 or later" >&2
    fi
    return 1
  fi
  return 0
}

# Quotes a value for the shell (and for make recipes), keeping any
# character literal.
sq () { printf "'%s'" "$(printf '%s' "$1" | sed "s/'/'\\\\''/g")"; }

# Escapes text for a Makefile variable ($ and #), then for the replacement
# part of a sed s||| command.
sed_escape () {
  printf '%s\n' "$1" | sed -e 's/\$/$$/g' -e 's/#/\\#/g' | sed -e 's/[\\&|]/\\&/g'
}

# libz3.dll and the Microsoft runtime DLLs official releases ship beside it.
Z3_RUNTIME_DLLS="libz3.dll msvcp140.dll msvcp140_1.dll msvcp140_2.dll vcruntime140.dll vcruntime140_1.dll vcomp140.dll"

: > config.log
Z3_CPPFLAGS=""
Z3_LIBS=""
Z3_DLL=""
Z3_DLLDIR=""
Z3_LICENSE=""
Z3_SOURCE=""

# Windows paths may use backslashes, which sed below would treat as escapes.
to_slash () { printf '%s\n' "$1" | sed 's|\\|/|g'; }
Z3_DIR=`to_slash "${Z3_DIR}"`
Z3_INCLUDE_DIR=`to_slash "${Z3_INCLUDE_DIR}"`
Z3_LIB_DIR=`to_slash "${Z3_LIB_DIR}"`

sha256_of () {
  if command -v sha256sum > /dev/null 2>&1; then sha256sum "$1" | cut -d ' ' -f 1
  elif command -v shasum > /dev/null 2>&1; then shasum -a 256 "$1" | cut -d ' ' -f 1
  elif command -v openssl > /dev/null 2>&1; then openssl dgst -sha256 "$1" | sed 's/.*= *//'
  fi
}
want_download () {
  case "${Z3R_DOWNLOAD}" in
    true|TRUE|yes|1) return 0 ;;
    false|FALSE|no|0) return 1 ;;
  esac
  test -n "${MY_UNIVERSE}"
}
# Downloads $1 (URL) to $2 with R, then checks the SHA-256 $3 and unzips.
fetch_z3 () {
  Z3_URL="$1" Z3_ZIP="$2" "${R_HOME}/bin${R_ARCH_BIN}/Rscript" --vanilla -e '
    options(timeout = max(900, getOption("timeout")))
    utils::download.file(Sys.getenv("Z3_URL"), Sys.getenv("Z3_ZIP"),
                         mode = "wb", quiet = TRUE)' >> config.log 2>&1
  got=""
  if test -f "$2"; then got=`sha256_of "$2"`; fi
  if test "${got}" != "$3"; then
    echo "configure.win: the Z3 download failed or its SHA-256 checksum does not match (got '${got}'); not using it" >&2
    return 1
  fi
  Z3_ZIP="$2" "${R_HOME}/bin${R_ARCH_BIN}/Rscript" --vanilla -e '
    f <- Sys.getenv("Z3_ZIP"); utils::unzip(f, exdir = dirname(f))' >> config.log 2>&1
  rm -f "$2"
}

# Opt-in download of a pinned official release (see the header), used only
# when no Z3 is given and pkg-config finds none.
if test -z "${PKG_LIBS}" && test -z "${Z3_DIR}" && test -z "${Z3_INCLUDE_DIR}" &&
   test -z "${Z3_LIB_DIR}" && ! pkg-config --exists z3 2>/dev/null &&
   want_download; then
  Z3_PIN=5.4.1
  case "`"${RBIN}" --vanilla -s -e 'cat(R.version$arch)'`" in
    aarch64) Z3_ASSET=z3-${Z3_PIN}-arm64-win
      Z3_SHA=1159ecd4cb008838471d816f09bdf69654a1908b47a7279fca2fc8dadbb81e0f ;;
    *) Z3_ASSET=z3-${Z3_PIN}-x64-win
      Z3_SHA=f16e991e1c883b0cee30c78eb445343e1a3f49c142aa7dead7d6c35f9cc44934 ;;
  esac
  Z3_URL="https://github.com/Z3Prover/z3/releases/download/z3-${Z3_PIN}/${Z3_ASSET}.zip"
  echo "configure.win: downloading Z3 ${Z3_PIN} from ${Z3_URL}"
  rm -rf src/z3bundle
  mkdir -p src/z3bundle
  if fetch_z3 "${Z3_URL}" "`pwd`/src/z3bundle/z3.zip" "${Z3_SHA}"; then
    Z3_DIR="`pwd`/src/z3bundle/${Z3_ASSET}"
  fi
fi

if test -n "${Z3_DIR}"; then
  : "${Z3_INCLUDE_DIR:=${Z3_DIR}/include}"
  : "${Z3_LIB_DIR:=${Z3_DIR}/bin}"
fi

if test -n "${PKG_LIBS}"; then
  Z3_CPPFLAGS="${PKG_CPPFLAGS}"
  Z3_LIBS="${PKG_LIBS}"
  Z3_SOURCE="PKG_CPPFLAGS/PKG_LIBS"
  try_z3 "${Z3_CPPFLAGS}" "${Z3_LIBS}" "" || Z3_SOURCE=""
elif test -n "${Z3_INCLUDE_DIR}" || test -n "${Z3_LIB_DIR}"; then
  Z3_CPPFLAGS="-I`sq "${Z3_INCLUDE_DIR}"`"
  if test -f "${Z3_LIB_DIR}/libz3.dll"; then
    Z3_DLL="${Z3_LIB_DIR}/libz3.dll"
    Z3_DLLDIR="${Z3_LIB_DIR}"
    Z3_LIBS=`sq "${Z3_DLL}"`
    # Z3's MIT license must accompany copies of the DLL.
    for f in "${Z3_LIB_DIR}/../LICENSE.txt" "${Z3_DIR}/LICENSE.txt"; do
      if test -f "$f"; then Z3_LICENSE="$f"; break; fi
    done
  else
    Z3_LIBS="-L`sq "${Z3_LIB_DIR}"` -lz3"
  fi
  Z3_SOURCE="Z3_INCLUDE_DIR/Z3_LIB_DIR"
  try_z3 "${Z3_CPPFLAGS}" "${Z3_LIBS}" "${Z3_DLLDIR}" || Z3_SOURCE=""
elif pkg-config --exists z3 2>/dev/null; then
  Z3_CPPFLAGS=`pkg-config --cflags z3`
  Z3_LIBS=`pkg-config --libs --static z3`
  Z3_SOURCE="pkg-config"
  try_z3 "${Z3_CPPFLAGS}" "${Z3_LIBS}" "" || Z3_SOURCE=""
fi

rm -f conftest.cpp conftest.exe conftest.err
for f in ${Z3_RUNTIME_DLLS}; do rm -f "$f"; done

if test -z "${Z3_SOURCE}"; then
  cat >&2 <<EOF
------------------------------------------------------------------------
configure.win: could not find a usable Z3 C library (4.8.13 or later).

1. Download and unpack an official release, for example
   z3-4.16.0-x64-win.zip from https://github.com/Z3Prover/z3/releases
2. Point z3r at it and reinstall, from R:
     Sys.setenv(Z3_DIR = "C:/path/to/z3-4.16.0-x64-win")
     install.packages("z3r", type = "source")
   or from a shell:
     Z3_DIR=C:/path/to/z3-4.16.0-x64-win R CMD INSTALL z3r
Or let configure.win download a pinned official Z3 release:
     Z3R_DOWNLOAD=true R CMD INSTALL z3r

Z3_INCLUDE_DIR and Z3_LIB_DIR (the folder holding libz3.dll), or
PKG_CPPFLAGS and PKG_LIBS, may be given instead. Compiler output is in
config.log.
------------------------------------------------------------------------
EOF
  exit 1
fi

echo "configure.win: using Z3 ${Z3_FOUND_VERSION} (found via ${Z3_SOURCE})"
sed -e "s|@Z3_CPPFLAGS@|`sed_escape "${Z3_CPPFLAGS}"`|" -e "s|@Z3_LIBS@|`sed_escape "${Z3_LIBS}"`|" \
    -e "s|@Z3_DLLDIR@|`sed_escape "${Z3_DLLDIR:+$(sq "${Z3_DLLDIR}")}"`|" \
    -e "s|@Z3_LICENSE@|`sed_escape "${Z3_LICENSE:+$(sq "${Z3_LICENSE}")}"`|" \
    src/Makevars.win.in > src/Makevars.win.new
if cmp -s src/Makevars.win.new src/Makevars.win; then
  rm -f src/Makevars.win.new
else
  mv src/Makevars.win.new src/Makevars.win
fi
exit 0
