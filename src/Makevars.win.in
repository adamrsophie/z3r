PKG_CPPFLAGS = @Z3_CPPFLAGS@
PKG_LIBS = @Z3_LIBS@
Z3_DLLDIR = @Z3_DLLDIR@
Z3_LICENSE = @Z3_LICENSE@

all: $(SHLIB) z3dll

# Install libz3.dll, the Microsoft runtime DLLs shipped beside it, and Z3's
# license next to z3r.dll, so that Windows finds them at load time.
# Z3_DLLDIR and Z3_LICENSE are already quoted for the shell by configure.win.
z3dll: $(SHLIB)
	@if test -n "$(R_PACKAGE_DIR)" && test -n "$(strip $(Z3_DLLDIR))"; then \
	  mkdir -p "$(R_PACKAGE_DIR)/libs$(R_ARCH)" && \
	  for f in libz3.dll msvcp140.dll msvcp140_1.dll msvcp140_2.dll vcruntime140.dll vcruntime140_1.dll vcomp140.dll; do \
	    if test -f $(Z3_DLLDIR)/$$f; then cp $(Z3_DLLDIR)/$$f "$(R_PACKAGE_DIR)/libs$(R_ARCH)/"; fi; \
	  done; \
	  if test -n "$(strip $(Z3_LICENSE))"; then cp $(Z3_LICENSE) "$(R_PACKAGE_DIR)/LICENSE.z3.txt"; fi; \
	fi

.PHONY: all z3dll

# Rebuild every object when the shared headers or the Z3 configuration
# (written by configure.win) change.
$(OBJECTS): z3r.h decl_kinds.h Makevars.win
