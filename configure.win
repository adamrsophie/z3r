#!/bin/sh
# Windows configuration (run by R with the Rtools shell).
#
# Search order:
#   1. PKG_CPPFLAGS and PKG_LIBS, used verbatim when PKG_LIBS is set.
#   2. Z3_DIR (the root of an unpacked official Z3 release, containing
#      include/ and bin/), or Z3_INCLUDE_DIR and Z3_LIB_DIR.
#   3. pkg-config z3 (for example an Rtools or MSYS2 z3 package).
#
# Official Z3 releases ship libz3.dll. The C API has a plain C ABI, so the
# MinGW toolchain of Rtools links against the DLL directly. The DLL, the
# Microsoft runtime DLLs shipped beside it and Z3's license are copied next
# to z3r.dll at install time, where Windows finds them when R loads the
# package. Headers and DLL must be the same Z3 version. Nothing is
# downloaded.

: "${R_HOME:=`R RHOME`}"
RBIN="${R_HOME}/bin${R_ARCH_BIN}/R"
CXX=`"${RBIN}" CMD config CXX`
CXXFLAGS=`"${RBIN}" CMD config CXXFLAGS`

try_z3 () {
  # $1 = preprocessor flags, $2 = linker flags (both may quote paths with
  # spaces; eval honors the quotes), $3 = DLL to copy beside the test program.
  cat > conftest.cpp <<EOF
#include <z3.h>
#include <stdio.h>
#if defined(__has_include)
#  if __has_include(<z3_version.h>)
#    include <z3_version.h>
#  endif
#endif
int main(void) {
  unsigned major, minor, build, rev;
  Z3_get_version(&major, &minor, &build, &rev);
  printf("%u.%u.%u\n", major, minor, build);
#ifdef Z3_MAJOR_VERSION
  if (major != Z3_MAJOR_VERSION || minor != Z3_MINOR_VERSION || build != Z3_BUILD_NUMBER) {
    fprintf(stderr, "Z3 headers are version %d.%d.%d but the library is %u.%u.%u",
            Z3_MAJOR_VERSION, Z3_MINOR_VERSION, Z3_BUILD_NUMBER, major, minor, build);
    return 3;
  }
#endif
  void *p = (void *) &Z3_get_string_contents;
  if (!p) return 2;
  if (major != 4) return major > 4 ? 0 : 1;
  if (minor != 8) return minor > 8 ? 0 : 1;
  return build >= 13 ? 0 : 1;
}
EOF
  rm -f conftest.exe
  eval "${CXX} $1 ${CXXFLAGS} conftest.cpp -o conftest.exe $2" >> config.log 2>&1 || return 1
  if test -n "$3"; then cp "$3" . 2>> config.log; fi
  Z3_FOUND_VERSION=`./conftest.exe 2> conftest.err`
  status=$?
  cat conftest.err >> config.log
  if test ${status} -ne 0; then
    if test ${status} -eq 3; then
      echo "configure.win: `cat conftest.err`; ignoring this Z3" >&2
    elif test -n "${Z3_FOUND_VERSION}"; then
      echo "configure.win: found Z3 ${Z3_FOUND_VERSION}, but z3r needs 4.8.13 or later" >&2
    fi
    return 1
  fi
  return 0
}

# Escapes text for the replacement part of a sed s||| command.
sed_escape () { printf '%s\n' "$1" | sed -e 's/[\\&|]/\\&/g'; }

: > config.log
Z3_CPPFLAGS=""
Z3_LIBS=""
Z3_DLL=""
Z3_DLLDIR=""
Z3_LICENSE=""
Z3_SOURCE=""

# Windows paths may use backslashes, which sed below would treat as escapes.
to_slash () { printf '%s\n' "$1" | sed 's|\\|/|g'; }
Z3_DIR=`to_slash "${Z3_DIR}"`
Z3_INCLUDE_DIR=`to_slash "${Z3_INCLUDE_DIR}"`
Z3_LIB_DIR=`to_slash "${Z3_LIB_DIR}"`

if test -n "${Z3_DIR}"; then
  : "${Z3_INCLUDE_DIR:=${Z3_DIR}/include}"
  : "${Z3_LIB_DIR:=${Z3_DIR}/bin}"
fi

if test -n "${PKG_LIBS}"; then
  Z3_CPPFLAGS="${PKG_CPPFLAGS}"
  Z3_LIBS="${PKG_LIBS}"
  Z3_SOURCE="PKG_CPPFLAGS/PKG_LIBS"
  try_z3 "${Z3_CPPFLAGS}" "${Z3_LIBS}" "" || Z3_SOURCE=""
elif test -n "${Z3_INCLUDE_DIR}" || test -n "${Z3_LIB_DIR}"; then
  Z3_CPPFLAGS="-I\"${Z3_INCLUDE_DIR}\""
  if test -f "${Z3_LIB_DIR}/libz3.dll"; then
    Z3_DLL="${Z3_LIB_DIR}/libz3.dll"
    Z3_DLLDIR="${Z3_LIB_DIR}"
    Z3_LIBS="\"${Z3_DLL}\""
    # Z3's MIT license must accompany copies of the DLL.
    for f in "${Z3_LIB_DIR}/../LICENSE.txt" "${Z3_DIR}/LICENSE.txt"; do
      if test -f "$f"; then Z3_LICENSE="$f"; break; fi
    done
  else
    Z3_LIBS="-L\"${Z3_LIB_DIR}\" -lz3"
  fi
  Z3_SOURCE="Z3_INCLUDE_DIR/Z3_LIB_DIR"
  try_z3 "${Z3_CPPFLAGS}" "${Z3_LIBS}" "${Z3_DLL}" || Z3_SOURCE=""
elif pkg-config --exists z3 2>/dev/null; then
  Z3_CPPFLAGS=`pkg-config --cflags z3`
  Z3_LIBS=`pkg-config --libs --static z3`
  Z3_SOURCE="pkg-config"
  try_z3 "${Z3_CPPFLAGS}" "${Z3_LIBS}" "" || Z3_SOURCE=""
fi

rm -f conftest.cpp conftest.exe conftest.err libz3.dll

if test -z "${Z3_SOURCE}"; then
  cat >&2 <<EOF
------------------------------------------------------------------------
configure.win: could not find a usable Z3 C library (4.8.13 or later).

1. Download and unpack an official release, for example
   z3-4.16.0-x64-win.zip from https://github.com/Z3Prover/z3/releases
2. Point z3r at it and reinstall, from R:
     Sys.setenv(Z3_DIR = "C:/path/to/z3-4.16.0-x64-win")
     install.packages("z3r", type = "source")
   or from a shell:
     Z3_DIR=C:/path/to/z3-4.16.0-x64-win R CMD INSTALL z3r

Z3_INCLUDE_DIR and Z3_LIB_DIR (the folder holding libz3.dll), or
PKG_CPPFLAGS and PKG_LIBS, may be given instead. Compiler output is in
config.log.
------------------------------------------------------------------------
EOF
  exit 1
fi

echo "configure.win: using Z3 ${Z3_FOUND_VERSION} (found via ${Z3_SOURCE})"
sed -e "s|@Z3_CPPFLAGS@|`sed_escape "${Z3_CPPFLAGS}"`|" -e "s|@Z3_LIBS@|`sed_escape "${Z3_LIBS}"`|" \
    -e "s|@Z3_DLLDIR@|`sed_escape "${Z3_DLLDIR}"`|" -e "s|@Z3_LICENSE@|`sed_escape "${Z3_LICENSE}"`|" \
    src/Makevars.win.in > src/Makevars.win.new
if cmp -s src/Makevars.win.new src/Makevars.win; then
  rm -f src/Makevars.win.new
else
  mv src/Makevars.win.new src/Makevars.win
fi
exit 0
